# Copy to backend/.env.local. Never commit real secrets.
# The same file lives at the repo root as `.env.example`.
# With no variables set, games stay in process memory, lessons come from the local fallback,
# and Prof and Spark use a fixed local plan.

# xAI Grok API. Without a key the pipeline uses a local lesson and drawn shapes,
# and the product screens use the same no-key fallback.
XAI_API_KEY=
# XAI_MODEL=grok-4.7
# Frontend image model default is grok-imagine-image-2.0. The engine default is grok-imagine-image.
# XAI_IMAGE_MODEL=grok-imagine-image-2.0
# XAI_STT_MODEL=grok-voice-transcribe-2.0
# XAI_REASONING_EFFORT=low

# Supabase. The service role key bypasses RLS. Server only.
# Do not prefix either variable with NEXT_PUBLIC_.
# Required in production so a game created on one instance can be played on another.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public origin used in gameUrl. On Vercel set this to the production alias.
# Falls back to the request host when unset, which is right for local dev.
# PUBLIC_BASE_URL=https://grok-hack-wro.vercel.app

# Leave unset on the combined app. The build route calls the engine in-process.
# Set this only when the UI in frontend/ runs on another host.
# API_BASE_URL=http://127.0.0.1:3001

# Optional. GAME_STORE=memory forces the process-local store even if Supabase is set.
# GAME_STORE=memory

# Browser origins allowed to call this API, comma-separated.
# Same-origin pages do not need to be listed. `*` is for a local demo only.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:3001

# Older name for PUBLIC_BASE_URL. Still read if PUBLIC_BASE_URL is unset.
# GAME_PUBLIC_URL_BASE=https://grok-hack-wro.vercel.app

# Not read by the current app. Play stays on this deployment.
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=

# Standalone frontend only (`npm run dev:web`). 1 runs the screens on demo data.
# NEXT_PUBLIC_FLOW_MOCK=0
