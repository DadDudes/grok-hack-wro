# Copy to backend/.env.local. Never commit real secrets.
# The same file lives at the repo root as `.env.example`.
# With no variables set, games stay in process memory and lessons come from the local fallback.

# xAI Grok API. Without a key the pipeline uses a local lesson and drawn shapes.
XAI_API_KEY=
# XAI_MODEL=grok-4.7
# XAI_IMAGE_MODEL=grok-imagine-image
# XAI_REASONING_EFFORT=low

# Supabase. The service role key bypasses RLS. Server only.
# Do not prefix either variable with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public origin used in gameUrl. Falls back to the request host.
# PUBLIC_BASE_URL=https://your-api.vercel.app

# Optional. GAME_STORE=memory forces the process-local store even if Supabase is set.
# GAME_STORE=memory

# Browser origins allowed to call this API, comma-separated.
# The colleague's frontend origin must be listed here.
# `*` is acceptable for a local hackathon demo only.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Older name for PUBLIC_BASE_URL. Still read if PUBLIC_BASE_URL is unset.
# GAME_PUBLIC_URL_BASE=https://your-api.vercel.app

# Colleague's frontend only. This API does not read it.
# Point it at this service. Next.js browser code needs the NEXT_PUBLIC_ form.
# API_BASE_URL=http://localhost:3001
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
