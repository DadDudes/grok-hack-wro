{
  "name": "@grok-hack/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:web": "node scripts/sync-frontend.mjs",
    "prebuild": "node scripts/sync-api-contract.mjs && node scripts/sync-frontend.mjs",
    "pretest": "node scripts/sync-api-contract.mjs",
    "pretypecheck": "node scripts/sync-api-contract.mjs && node scripts/sync-frontend.mjs",
    "predev": "node scripts/sync-api-contract.mjs && node scripts/sync-frontend.mjs",
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/sync-frontend.mjs --check && node --experimental-strip-types --import ./scripts/register-alias.mjs --test lib/game-spec/fallback.test.ts lib/game-spec/request-fields.test.ts lib/play/render-html.test.ts lib/games/pipeline.test.ts lib/agents/pedagog.test.ts lib/agents/local-fallback.test.ts lib/flow/hintTurn.test.ts lib/flow/sessionReport.test.ts",
    "test:play": "playwright test",
    "smoke": "node scripts/smoke-unified.mjs",
    "exercise": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/exercise-pipeline.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "next": "^16.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vercel/config": "^0.14.1",
    "typescript": "^5.9.3"
  }
}
