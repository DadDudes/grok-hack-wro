# Copy to backend/.env.local before `npm run dev` if you want real services.
# The API stub runs with none of these set. Never commit real secrets.

# xAI Grok API. Not called by the stub. Used when game-code generation is implemented.
XAI_API_KEY=
# XAI_MODEL=grok-4

# Supabase. The service role key bypasses RLS. Server only.
# Do not prefix either variable with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Deployment API. Not called by the stub.
# Used when each game is published as its own deployment.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=

# Browser origins allowed to call this API, comma-separated.
# The colleague's frontend origin must be listed here.
# `*` is acceptable for a local hackathon demo only.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Optional overrides for the placeholder URLs the stub returns.
# GAME_PUBLIC_URL_BASE=https://games.example.invalid
# GAME_ASSET_BASE_URL=https://cdn.example.invalid/game-assets

# Colleague's frontend only. This API does not read it.
# Point it at this service. Next.js browser code needs the NEXT_PUBLIC_ form.
# API_BASE_URL=http://localhost:3001
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
